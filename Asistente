    lotesSociedades: 8, // cuántas sociedades se consultan a la vez
    // Personas que revisan expedientes (lista desplegable del panel)
    revisores: [
      'Alejandro Saint-Hilaire', 'Ana Margarita Marte Paulino', 'Anabel Gonzalez Garcia',
      'Bennedit Rodríguez Castillo', 'Darlenys Sepulveda Cedeño', 'Fabricio Arístides Nolasco Gómez',
      'Francisco Melo Wilson', 'Jhon Oscar Sosa Mena', 'Juana Reyes', 'Malvin Jordany Mejía Beato',
      'Maria Isabel Sosa', 'Prada Santana Hidalgo', 'Tomás Guerrero Nova', 'Wilmar Rodriguez',
      'Yamel Maria Feliz Figuereo', 'Yeny Abreu Guzmán',
    ],
  };

  // Nombres posibles de cada campo en las respuestas de Looking For.
  // Se detectan sin importar mayúsculas. Ajusta cuando veas el log real.
  const CAMPOS = {
    expediente: ['expediente', 'numeroexpediente', 'noexpediente', 'idexpediente', 'numero', 'documento'],
    caja:       ['caja', 'codigocaja', 'nocaja', 'ubicacion', 'location'],
    persona:    ['quienrevisa', 'revisor', 'revisadopor', 'analista', 'asignadoa', 'asignado', 'usuario', 'responsable', 'nombre'],
    estado:     ['estado', 'status', 'estatus'],
    fecha:      ['fechareporte', 'fecha', 'fecharegistro', 'fechamovimiento', 'fechacreacion', 'date'],
  };

  // Un conector por intención. Mientras url sea null, el bot avisa que falta configurarlo.
  // url: dirección absoluta dentro de Looking For. {param} se reemplaza por el valor de la pregunta.
  // cuerpos: lista de cuerpos POST a probar en orden; el primero que devuelve datos se recuerda.
  // tipo: 'json' | 'html' (lee la primera tabla) | 'parrafos' (lee <p> del historial).
  // Descubierto en el log del 2026-11-05: las búsquedas son POST a /class/buscador/*.php
  const CONECTORES = {
    ubicacion: {
      // Confirmado: sociedad=0041&objeto=BAC4125050003
      metodo: 'POST', soloLectura: true, url: '/class/buscador/expediente.php', tipo: 'json',
      cuerpos: ['sociedad={sociedad}&objeto={expediente}'],
      valido: () => true,
    },
    contenido_caja: {
      metodo: 'POST', soloLectura: true, url: '/class/buscador/contenido_caja.php', tipo: 'html',
      cuerpos: ['objeto={caja}', 'caja={caja}', 'codigo_caja={caja}', 'id_caja={caja}', 'nombre_caja={caja}', 'buscar={caja}',
                'valor={caja}', 'busqueda={caja}', 'codigo={caja}', 'q={caja}'],
      valido: filas => filas.length > 0,
    },
    historial: {
      metodo: 'POST', soloLectura: true, url: '/class/buscador/consulta_historial.php', tipo: 'parrafos',
      cuerpos: ['id_expediente={id}'], // necesita el id interno: se obtiene antes con "ubicacion"
      valido: () => true,
    },
    // Pendientes de capturar con el Explorador:
    // Pantalla "Acuse expdte. para revisar": GET ?action=reporte/revision_expedientes&fecha=AAAA-MM-DD
    // (devuelve la página completa; se lee la tabla que tiene la columna "Cheque")
    pagos_pendientes: {
      metodo: 'GET', url: '{base}?action=reporte%2Frevision_expedientes&fecha={fecha}', tipo: 'html',
      accion: 'reporte/revision_expedientes', columnaClave: 'cheque',
    },
    asignados:           { metodo: 'GET', url: null, tipo: 'json' }, // {persona}
    pendientes_descargo: { metodo: 'GET', url: null, tipo: 'json' }, // {persona}
    por_estado:          { metodo: 'GET', url: null, tipo: 'json' }, // {estado} {desde} {hasta}
    por_fecha:           { metodo: 'GET', url: null, tipo: 'json' }, // {desde} {hasta}
  };

  // ───────────────────────── 1. EXPLORADOR (fase 0) ─────────────────────────
  const LOG_KEY = 'lf_explorador_log';
  const ON_KEY = 'lf_explorador_on';
  let explorando = GM_getValue(ON_KEY, false);
  let log = GM_getValue(LOG_KEY, []);

  function sociedadesConocidas() {
    const set = new Set([...Object.keys(CONFIG.sociedades), ...GM_getValue('lf_sociedades', [])]);
    try {
      document.querySelectorAll('select[name*="sociedad" i] option, select[id*="sociedad" i] option')
        .forEach(o => { if (/^\d{3,4}$/.test(o.value.trim())) set.add(o.value.trim().padStart(4, '0')); });
    } catch (e) { /* ignorar */ }
    const hits = GM_getValue('lf_soc_hits', {});
    return [...set].filter(c => c !== '0001').sort((a, b) => (hits[b] || 0) - (hits[a] || 0) || a.localeCompare(b));
  }

  const nombreSociedad = c => CONFIG.sociedades[c] ? `${c} (${CONFIG.sociedades[c]})` : c;

  function aprenderSociedad(cuerpo) {
    const m = String(cuerpo || '').match(/(?:^|&)sociedad=(\d{3,4})/);
    if (!m) return;
    const lista = GM_getValue('lf_sociedades', []);
    const soc = m[1].padStart(4, '0');
    if (!lista.includes(soc)) { lista.push(soc); GM_setValue('lf_sociedades', lista); }
  }

  function registrar(entrada) {
    aprenderSociedad(entrada.cuerpo);
    if (!explorando) return;
    if (/\.(js|css|png|jpe?g|gif|svg|woff2?|ico)(\?|$)/i.test(entrada.url)) return;
    log.push(entrada);
    if (log.length > CONFIG.maxLog) log = log.slice(-CONFIG.maxLog);
    GM_setValue(LOG_KEY, log);
    actualizarContadorLog();
  }

  function absoluta(url) {
    try { return new URL(String(url), location.href).href; } catch (e) { return String(url); }
  }

  // Convierte cualquier cuerpo (texto, FormData, URLSearchParams, objeto) a "clave=valor&..."
  function serializarCuerpo(b) {
    try {
      if (b == null) return '';
      if (typeof b === 'string') return b.slice(0, 1000);
      if (b instanceof W.URLSearchParams || b instanceof URLSearchParams) return b.toString().slice(0, 1000);
      if (b instanceof W.FormData || b instanceof FormData) {
        const partes = [];
        b.forEach((v, k) => partes.push(`${k}=${typeof v === 'string' ? v : '[archivo]'}`));
        return partes.join('&').slice(0, 1000);
      }
      if (b instanceof Blob) return `[blob ${b.type} ${b.size} bytes]`;
      return JSON.stringify(b).slice(0, 1000);
    } catch (e) { return '[no legible]'; }
  }

  function muestra(texto) {
    return typeof texto === 'string' ? texto.slice(0, 1500) : '';
  }

  // Intercepta fetch
  const fetchOriginal = W.fetch;
  if (fetchOriginal) {
    W.fetch = async function (input, init) {
      const resp = await fetchOriginal.apply(this, arguments);
      try {
        const url = typeof input === 'string' ? input : input.url;
        const metodo = (init && init.method) || (input && input.method) || 'GET';
        const cuerpo = serializarCuerpo(init && init.body);
        resp.clone().text().then(t => registrar({
          t: new Date().toISOString(), via: 'fetch', metodo, url: absoluta(url), cuerpo,
          status: resp.status, tipo: resp.headers.get('content-type') || '', muestra: muestra(t),
        })).catch(() => {});
      } catch (e) { /* nunca romper la página */ }
      return resp;
    };
  }

  // Intercepta XMLHttpRequest
  const XHR = W.XMLHttpRequest;
  if (XHR) {
    const abrir = XHR.prototype.open;
    const enviar = XHR.prototype.send;
    XHR.prototype.open = function (metodo, url) {
      this.__lf = { metodo, url: absoluta(url) };
      return abrir.apply(this, arguments);
    };
    XHR.prototype.send = function (cuerpo) {
      const info = this.__lf || {};
      this.addEventListener('load', () => {
        try {
          const texto = this.responseType === '' || this.responseType === 'text' ? this.responseText : '';
          registrar({
            t: new Date().toISOString(), via: 'xhr', metodo: info.metodo, url: info.url,
            cuerpo: serializarCuerpo(cuerpo),
            status: this.status, tipo: this.getResponseHeader('content-type') || '', muestra: muestra(texto),
          });
        } catch (e) { /* ignorar */ }
      });
      return enviar.apply(this, arguments);
    };
  }

  // Cada página que se abre (los enlaces que recargan la página no pasan por fetch/XHR)
  registrar({ t: new Date().toISOString(), via: 'pagina', metodo: 'GET', url: location.href, cuerpo: '', status: 0, tipo: 'pagina', muestra: '' });

  // Clics en enlaces y botones: guarda a dónde apuntan y qué datos llevan
  W.addEventListener('click', ev => {
    try {
      const b = ev.target.closest && ev.target.closest('a, button, [onclick], [data-id], .badge');
      if (!b || b.closest('#lf-asistente')) return;
      const datos = [...b.attributes].filter(a => /^(data-|onclick|href|id|value|name)/.test(a.name))
        .map(a => `${a.name}=${a.value}`).join(' | ');
      registrar({ t: new Date().toISOString(), via: 'clic', metodo: '', url: b.getAttribute('href') ? absoluta(b.getAttribute('href')) : location.href,
        cuerpo: datos.slice(0, 1000), status: 0, tipo: 'clic', muestra: b.textContent.replace(/\s+/g, ' ').trim().slice(0, 200) });
    } catch (e) { /* ignorar */ }
  }, true);

  // Formularios que recargan la página completa (plan B: páginas HTML)
  W.addEventListener('submit', ev => {
    try {
      const f = ev.target;
      const datos = new URLSearchParams(new FormData(f)).toString();
      // f.action puede estar tapado por un campo llamado "action": se lee el atributo
      const destino = absoluta(f.getAttribute('action') || location.pathname);
      const acc = new FormData(f).get('action');
      if (typeof acc === 'string' && acc) GM_setValue('lf_form_url_' + acc, new URL(destino).pathname);
      registrar({ t: new Date().toISOString(), via: 'form', metodo: (f.getAttribute('method') || 'GET').toUpperCase(),
        url: destino, cuerpo: datos.slice(0, 1000), status: 0, tipo: 'form', muestra: '' });
    } catch (e) { /* ignorar */ }
  }, true);

  // ───────────────────────── 2. INTÉRPRETE ─────────────────────────
  const sinAcentos = s => s.normalize('NFD').replace(/[̀-ͯ]/g, '');
  const norm = s => sinAcentos(String(s || '')).toLowerCase().trim();

  const pad = n => String(n).padStart(2, '0');
  const iso = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  const sumarDias = (d, n) => { const x = new Date(d); x.setDate(x.getDate() + n); return x; };

  function restarMeses(d, k) {
    const x = new Date(d); x.setMonth(x.getMonth() - k); x.setDate(x.getDate() + 1); return x;
  }

  function rangoDeMes(a, m) {
    return { desde: iso(new Date(a, m, 1)), hasta: iso(new Date(a, m + 1, 0)) };
  }

  function leerFecha(txt, anioBase) {
    const m = txt.match(/(\d{1,2})[\/\-](\d{1,2})(?:[\/\-](\d{2,4}))?/);
    if (!m) return null;
    let anio = m[3] ? Number(m[3]) : anioBase;
    if (anio < 100) anio += 2000;
    return new Date(anio, Number(m[2]) - 1, Number(m[1]));
  }

  function rangoFechas(q) {
    const hoy = new Date(); hoy.setHours(0, 0, 0, 0);
    const anio = hoy.getFullYear();
    const entre = q.match(/(?:del|desde(?: el)?)\s+(\d{1,2}[\/\-]\d{1,2}(?:[\/\-]\d{2,4})?)\s+(?:al|hasta(?: el)?)\s+(\d{1,2}[\/\-]\d{1,2}(?:[\/\-]\d{2,4})?)/);
    if (entre) return { desde: iso(leerFecha(entre[1], anio)), hasta: iso(leerFecha(entre[2], anio)) };
    // "últimos 3 meses", "último mes", "últimos doce meses"
    const nums = { un: 1, uno: 1, dos: 2, tres: 3, cuatro: 4, cinco: 5, seis: 6, siete: 7, ocho: 8, nueve: 9, diez: 10, once: 11, doce: 12 };
    const ult = q.match(/ultim[oa]s?\s+(\d+|un|uno|dos|tres|cuatro|cinco|seis|siete|ocho|nueve|diez|once|doce)?\s*mes(es)?/);
    if (ult) {
      const k = ult[1] ? (nums[ult[1]] || Number(ult[1])) : (ult[2] ? 3 : 1); // "últimos meses" sin número = 3
      return { desde: iso(restarMeses(hoy, k)), hasta: iso(hoy) };
    }
    // "octubre", "octubre 2025", "septiembre de 2026", "10/2026"
    const MESES = ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre'];
    const mn = q.match(/\b(enero|febrero|marzo|abril|mayo|junio|julio|agosto|sep?tiembre|octubre|noviembre|diciembre)\b(?:\s+(?:de|del)?\s*(\d{4}))?/);
    const mnum = q.match(/\b(\d{1,2})[\/\-](\d{4})\b/);
    if (mn || mnum) {
      const m = mn ? MESES.indexOf(mn[1].replace('setiembre', 'septiembre')) : Number(mnum[1]) - 1;
      let a = mn ? (mn[2] ? Number(mn[2]) : anio) : Number(mnum[2]);
      if (mn && !mn[2] && m > hoy.getMonth()) a -= 1; // "diciembre" en noviembre = el del año pasado
      return rangoDeMes(a, m);
    }
    if (/\bhoy\b/.test(q)) return { desde: iso(hoy), hasta: iso(hoy) };
    if (/\bayer\b/.test(q)) { const a = sumarDias(hoy, -1); return { desde: iso(a), hasta: iso(a) }; }
    const lunes = sumarDias(hoy, -((hoy.getDay() + 6) % 7));
    if (/semana pasada/.test(q)) return { desde: iso(sumarDias(lunes, -7)), hasta: iso(sumarDias(lunes, -1)) };
    if (/esta semana|la semana/.test(q)) return { desde: iso(lunes), hasta: iso(hoy) };
    if (/mes pasado/.test(q)) {
      const ini = new Date(anio, hoy.getMonth() - 1, 1), fin = new Date(anio, hoy.getMonth(), 0);
      return { desde: iso(ini), hasta: iso(fin) };
    }
    if (/este mes|el mes/.test(q)) return { desde: iso(new Date(anio, hoy.getMonth(), 1)), hasta: iso(hoy) };
    const una = q.match(/\b(?:el|del|en)\s+(\d{1,2}[\/\-]\d{1,2}(?:[\/\-]\d{2,4})?)/);
    if (una) { const d = iso(leerFecha(una[1], anio)); return { desde: d, hasta: d }; }
    return null;
  }

  // Toma el nombre tal como lo escribió el usuario (con mayúsculas y acentos)
  function extraerPersona(original) {
    const m = original.match(/\b(?:asignad[oa]s?\s+a|tiene\s+asignad[oa]s?|tiene|de|a)\s+((?:[A-ZÁÉÍÓÚÑ][a-záéíóúñ]+\s*){1,4})/);
    return m ? m[1].trim() : null;
  }

  // Busca en la lista de revisores el nombre mencionado (sin acentos, basta nombre + un apellido)
  function resolverRevisor(texto) {
    const t = ' ' + norm(texto).replace(/[^a-z\s-]/g, ' ') + ' ';
    let mejor = null, puntos = 0;
    CONFIG.revisores.forEach(r => {
      const partes = norm(r).split(/\s+/);
      const p = partes.filter(x => x.length > 2 && t.includes(' ' + x + ' ')).length;
      if (p > puntos) { mejor = r; puntos = p; }
    });
    if (puntos >= 2) return mejor;
    // con una sola palabra, solo si ningún otro revisor la comparte (ej. "Yeny", no "Sosa" ni "Maria")
    if (puntos === 1) {
      const usadas = norm(mejor).split(/\s+/).filter(x => x.length > 2 && t.includes(' ' + x + ' '));
      const compartida = CONFIG.revisores.some(r => r !== mejor && usadas.some(x => norm(r).split(/\s+/).includes(x)));
      return compartida ? null : mejor;
    }
    return null;
  }

  // Lo que queda de la pregunta tras quitar palabras comunes y fechas = nombre del receptor del pago
  const VACIAS = new Set(('que hay tiene tienen tengo pago pagos pendiente pendientes acuse acuses expediente expedientes debe deben ' +
    'revisado revisados revisada revisadas revisamos hemos han ha revision ' +
    'del de la el los las en a al para por con y o receptor receptores proveedor beneficiario quien quienes revisa revisar ' +
    'cuanto cuantos cuantas cuales cual cuando mes meses ultimo ultimos ultima ultimas este esta estos semana pasada pasado ' +
    'hoy ayer desde hasta dame muestrame busca buscar dime lista todos todas fecha fechas sin asignar sobre me se ' +
    'enero febrero marzo abril mayo junio julio agosto septiembre setiembre octubre noviembre diciembre ' +
    'un uno dos tres cuatro cinco seis siete ocho nueve diez once doce').split(' '));

  function extraerReceptor(q) {
    const resto = q.replace(/\d{1,2}[\/\-]\d{1,2}([\/\-]\d{2,4})?|\d{1,2}[\/\-]\d{4}|\b\d+\b/g, ' ')
      .replace(/[^a-z0-9&\.\s-]/g, ' ').split(/\s+/).filter(w => w && !VACIAS.has(w));
    return resto.length ? resto.join(' ') : null;
  }

  function interpretar(original) {
    const q = norm(original);
    const expediente = /\blote\b/.test(q) ? null : (original.match(/\b(?:[A-Za-z]{2,4}\d{6,}|\d{5,})\b/) || [])[0] || null;
    const caja = (sinAcentos(original).match(/\bcaja\s*(?:no\.?|numero|#)?\s*([a-z0-9][a-z0-9\-]*)/i) || [])[1] || null;
    const persona = extraerPersona(original);
    const sociedad = ((q.match(/\bsociedad\s*(\d{1,4})/) || [])[1] || '').padStart(4, '0').replace(/^0000$/, '') || null;
    const fechas = rangoFechas(q);
    const soloConteo = /\bcuant[oa]s\b/.test(q);
    const estado = (q.match(/\b(?:estado|en estado|estatus)\s+([a-z ]{3,30}?)(?:\?|$|\s+(?:de|del|esta|este|hoy))/) || [])[1] || null;

    if (/\b(en )?esta (tabla|pantalla|pagina|lista)\b|\ben pantalla\b/.test(q)) {
      const termino = (q.match(/(?:busca|filtra(?: por)?|con|que (?:diga|contenga))\s+["']?([^"'?]+)["']?/) || [])[1];
      return { intencion: 'tabla_visible', termino: termino ? termino.trim() : null, soloConteo };
    }
    if (expediente && /(quien|movio|historial|movimientos|traza|consult)/.test(q)) return { intencion: 'historial', expediente, sociedad };
    if (expediente) return { intencion: 'ubicacion', expediente, sociedad };
    if (caja && /(que hay|contiene|contenido|expedientes|cuant)/.test(q)) return { intencion: 'contenido_caja', caja, soloConteo };
    if (/revisad[oa]s?\b|revisi[oó]n/.test(q) && !/para revisar|por revisar/.test(q)) {
      const revisor = /(receptor|proveedor|beneficiario)/.test(q) ? null : resolverRevisor(original);
      const lote = (q.match(/\blote\s*(?:no\.?|#)?\s*(\d{6,8})/) || [])[1] || null;
      return { intencion: 'revisados', estado: 'REVISADO', lote, persona: revisor, receptor: revisor || lote ? null : extraerReceptor(q), soloConteo, ...(fechas || {}) };
    }
    // "pendientes" sin hablar de pagos/acuses/descargo = pendientes de los lotes del histórico
    if (/\bpendientes?\b/.test(q) && !/(descargo|deb\w*|pagos?|acuses?|sin asignar|en blanco|por revisar|para revisar)/.test(q)) {
      const revisor = /(receptor|proveedor|beneficiario)/.test(q) ? null : resolverRevisor(original);
      const lote = (q.match(/\blote\s*(?:no\.?|#)?\s*(\d{6,8})/) || [])[1] || null;
      return { intencion: 'revisados', estado: 'PENDIENTE', lote, persona: revisor, receptor: revisor || lote ? null : extraerReceptor(q), soloConteo, ...(fechas || {}) };
    }
    const sinAsignar = /(sin asignar|no asignad\w*|en blanco|sin revisor|sin responsable|nadie asignad\w*)/.test(q);
    if (sinAsignar || /\b(deb\w*|pagos?|acuses?|por revisar|para revisar|receptor|proveedor|beneficiario)\b/.test(q)) {
      const revisor = sinAsignar || /(receptor|proveedor|beneficiario)/.test(q) ? null : resolverRevisor(original);
      return { intencion: 'pagos_pendientes', persona: revisor, sinAsignar, receptor: revisor || sinAsignar ? null : extraerReceptor(q),
        soloConteo, ...(fechas || {}) };
    }
    if (persona && /(descargo|pendiente|por aceptar|sin aceptar)/.test(q)) return { intencion: 'pendientes_descargo', persona, soloConteo };
    if (persona && /(asignad|tiene)/.test(q)) return { intencion: 'asignados', persona, soloConteo };
    if (/(por estado|estado|estatus)/.test(q)) return { intencion: 'por_estado', estado, ...(fechas || {}), soloConteo };
    if (fechas) {
      const mov = (q.match(/\b(recib\w+|mov\w+|acept\w+|descarg\w+|cread\w+|registr\w+)/) || [])[1] || null;
      return { intencion: 'por_fecha', ...fechas, movimiento: mov, soloConteo };
    }
    if (caja) return { intencion: 'contenido_caja', caja, soloConteo };
    return { intencion: 'desconocida' };
  }

  // ───────────────────────── 3. CONECTORES ─────────────────────────
  function rellenarUrl(plantilla, p) {
    return plantilla.replace(/\{(\w+)\}/g, (_, k) => encodeURIComponent(p[k] == null ? '' : p[k]));
  }

  function porRuta(obj, ruta) {
    if (!ruta) return obj;
    return ruta.split('.').reduce((o, k) => (o == null ? o : o[k]), obj);
  }

  // Texto de la celda; si está vacío, el valor de su campo (ej. "Quien revisa?" es un input)
  function valorCelda(td) {
    const txt = td.textContent.replace(/\s+/g, ' ').trim();
    if (txt) return txt;
    const campoForm = td.querySelector('input:not([type=checkbox]):not([type=hidden]):not([type=button]), select, textarea');
    if (!campoForm) return '';
    if (campoForm.tagName === 'SELECT') {
      const op = campoForm.querySelector('option[selected]') || campoForm.options[campoForm.selectedIndex];
      return op && op.value ? op.textContent.trim() : '';
    }
    return (campoForm.value || campoForm.getAttribute('value') || '').trim();
  }

  function tablaAFilas(tabla) {
    const filasHtml = [...tabla.querySelectorAll('tr')];
    if (!filasHtml.length) return [];
    const enc = [...filasHtml[0].querySelectorAll('th,td')].map((c, i) => c.textContent.trim() || `col${i + 1}`);
    return filasHtml.slice(1).map(tr => {
      const celdas = [...tr.querySelectorAll('td')];
      const fila = {};
      enc.forEach((h, i) => { fila[h] = celdas[i] ? valorCelda(celdas[i]) : ''; });
      return fila;
    }).filter(f => Object.values(f).some(v => v));
  }

  function parrafosAFilas(html) {
    const doc = new DOMParser().parseFromString(html, 'text/html');
    return [...doc.querySelectorAll('p')].map(p => {
      const texto = p.textContent.replace(/\s+/g, ' ').trim();
      const usuario = (p.querySelector('b') || {}).textContent || '';
      const fecha = (texto.match(/\d{4}-\d{2}-\d{2}(?: \d{2}:\d{2}(?::\d{2})?)?/) || [])[0] || '';
      return { fecha, usuario, detalle: texto };
    }).filter(f => f.detalle);
  }

  async function pedir(c, cuerpo, intento) {
    const opciones = { method: c.metodo, credentials: 'include', headers: { 'X-Requested-With': 'XMLHttpRequest' } };
    if (c.metodo !== 'GET') {
      opciones.body = rellenarUrl(cuerpo || '', intento);
      opciones.headers['Content-Type'] = 'application/x-www-form-urlencoded; charset=UTF-8';
    }
    const resp = await fetchOriginal.call(W, absoluta(rellenarUrl(c.url, intento)), opciones);
    if (!resp.ok) throw new Error(`Looking For respondió ${resp.status}. Verifica que tu sesión siga activa.`);
    const texto = await resp.text();
    registrar({ t: new Date().toISOString(), via: 'bot', metodo: c.metodo, url: absoluta(rellenarUrl(c.url, intento)),
      cuerpo: opciones.body || '', status: resp.status, tipo: resp.headers.get('content-type') || '', muestra: muestra(texto) });
    if (c.tipo === 'html') {
      const tabla = new DOMParser().parseFromString(texto, 'text/html').querySelector(c.selectorTabla || 'table');
      return tabla ? tablaAFilas(tabla) : [];
    }
    if (c.tipo === 'parrafos') return parrafosAFilas(texto);
    try { return JSON.parse(texto.trim()); } catch (e) { return null; }
  }

  // Prueba los cuerpos candidatos y recuerda el que funcionó
  async function consultarCrudo(nombre, intento) {
    const c = CONECTORES[nombre];
    if (!c || !c.url) {
      throw new Error(`El conector "${nombre}" aún no está configurado. Activa el Explorador, haz esa búsqueda en Looking For y comparte el log.`);
    }
    c.metodo = (c.metodo || 'GET').toUpperCase();
    if (c.metodo !== 'GET' && !c.soloLectura) {
      throw new Error('Bloqueado: el bot solo hace consultas de lectura.');
    }
    const clave = 'lf_cuerpo_' + nombre;
    const recordado = GM_getValue(clave, null);
    const lista = c.cuerpos && c.cuerpos.length ? c.cuerpos : [''];
    const orden = recordado && lista.includes(recordado) ? [recordado, ...lista.filter(x => x !== recordado)] : lista;
    for (const cuerpo of orden) {
      const datos = await pedir(c, cuerpo, intento);
      if (!c.valido || c.valido(datos)) {
        GM_setValue(clave, cuerpo);
        return datos;
      }
      if (recordado && cuerpo === recordado) return datos; // el recordado responde pero sin resultados: no existe
    }
    return null;
  }

  // Una respuesta cuenta solo si trae id y el mismo número de cheque que se pidió
  function chequeValido(d, buscado) {
    return !!(d && d.existe === true && d.id && d.cheque &&
      String(d.cheque).trim().toUpperCase() === String(buscado).trim().toUpperCase());
  }

  // Busca el cheque en la sociedad indicada o en todas las conocidas
  async function buscarCheque(intento) {
    const lista = intento.sociedad ? [intento.sociedad] : sociedadesConocidas();
    const hallados = [];
    const tam = intento.sociedad ? 1 : CONFIG.lotesSociedades;
    for (let i = 0; i < lista.length && !hallados.length; i += tam) {
      const lote = lista.slice(i, i + tam);
      const res = await Promise.all(lote.map(sociedad => consultarCrudo('ubicacion', { ...intento, sociedad }).catch(() => null)));
      res.forEach(d => { if (chequeValido(d, intento.expediente)) hallados.push(d); });
    }
    const hits = GM_getValue('lf_soc_hits', {});
    hallados.forEach(d => { hits[d.sociedad] = (hits[d.sociedad] || 0) + 1; });
    GM_setValue('lf_soc_hits', hits);
    hallados.forEach(d => Object.keys(d).forEach(k => { if (typeof d[k] === 'string') d[k] = decodificar(d[k]); }));
    return hallados;
  }

  function decodificar(t) {
    const x = document.createElement('textarea');
    x.innerHTML = t;
    return x.value;
  }

  async function consultar(intento) {
    const n = intento.intencion;
    if (n === 'ubicacion') return buscarCheque(intento);
    if (n === 'historial') {
      const d = (await buscarCheque(intento))[0];
      if (!d) return [];
      const filas = await consultarCrudo('historial', { ...intento, id: d.id });
      return (filas || []).slice(0, CONFIG.maxFilas);
    }
    if (n === 'pagos_pendientes') return pagosPorFechas(intento);
    if (n === 'revisados') return revisadosHistorico(intento);
    const datos = await consultarCrudo(n, intento);
    const c = CONECTORES[n];
    const lista = Array.isArray(datos) ? datos : porRuta(datos, c.filas);
    const filas = Array.isArray(lista) ? lista : (lista ? [lista] : []);
    return filas.slice(0, CONFIG.maxFilas);
  }

  // Mientras no se conecte la consulta directa: lee la tabla abierta en Looking For
  function pagosDesdePantalla(intento) {
    let filas;
    try { filas = consultarTablaVisible({}); } catch (e) {
      throw new Error('Todavía no tengo conectada la consulta de pagos. Abre en Looking For la pantalla donde se ven los pagos pendientes y vuelve a preguntar (y si puedes, activa el Explorador y mándame el log de esa pantalla).');
    }
    if (intento.persona) {
      const partes = norm(intento.persona).split(/\s+/).filter(x => x.length > 2).slice(0, 2);
      filas = filas.filter(f => { const txt = norm(Object.values(f).join(' ')); return partes.every(x => txt.includes(x)); });
    }
    return filas;
  }

  function resumenPersonas(filas) {
    const c = {};
    filas.forEach(f => { const p = f.quien_revisa || '(sin asignar)'; c[p] = (c[p] || 0) + 1; });
    return Object.entries(c).sort((a, b) => b[1] - a[1]).map(([p, k]) => `${p}: ${k}`).join(' · ');
  }

  // ── Histórico de revisados ──
  // Detalle de un lote: /modulo/dashboard.php?action=reporte/listado_acuses&documento=1001504&estado=REVISADO
  const URL_LOTE = '/modulo/dashboard.php?action=reporte%2Flistado_acuses&documento={lote}&estado=REVISADO';
  const LOTE_INICIAL = 1001505;

  // Aprende el último lote visto en pantalla (ej. "2026-11-04 14:19:11 | 1001505") o en la dirección
  function aprenderLote() {
    try {
      let max = GM_getValue('lf_ultimo_lote', LOTE_INICIAL);
      const enUrl = new URL(location.href).searchParams.get('documento');
      if (/^\d{6,8}$/.test(enUrl || '')) max = Math.max(max, Number(enUrl));
      const txt = document.body ? document.body.innerText || '' : '';
      (txt.match(/\|\s*(\d{7})\b/g) || []).forEach(m => { max = Math.max(max, Number(m.replace(/\D/g, ''))); });
      GM_setValue('lf_ultimo_lote', max);
    } catch (e) { /* ignorar */ }
  }

  function filaRevisado(f, lote) {
    return {
      lote,
      fecha: campoTexto(f, 'fecha'),
      revisado_por: campoTexto(f, 'revisado por'),
      sociedad: nombreSociedad(campoTexto(f, 'sociedad')),
      receptor: campoTexto(f, 'receptor del pago'),
      cheque: campoTexto(f, 'cheque/transferencia'),
      documento: campoTexto(f, 'documento pago'),
      moneda: campoTexto(f, 'moneda'),
      importe: campoTexto(f, 'importe'),
      emisor: campoTexto(f, 'emisor'),
    };
  }

  // Lotes con más de 3 días se guardan en caché (ya no cambian salvo una anulación)
  let cacheLotes = null;
  function cache() { if (!cacheLotes) cacheLotes = GM_getValue('lf_cache_lotes', {}); return cacheLotes; }
  function guardarCache() { try { GM_setValue('lf_cache_lotes', cacheLotes); } catch (e) { /* lleno: se ignora */ } }

  async function tablaDeLote(lote, estado, columna) {
    const url = absoluta(URL_LOTE.replace('{lote}', lote).replace('estado=REVISADO', 'estado=' + encodeURIComponent(estado)));
    const resp = await fetchOriginal.call(W, url, { credentials: 'include' });
    if (!resp.ok) throw new Error(`Looking For respondió ${resp.status} al abrir el lote ${lote}. Verifica que tu sesión siga activa.`);
    return tablaConColumna(new DOMParser().parseFromString(await resp.text(), 'text/html'), columna);
  }

  async function revisadosDeLote(lote) {
    const c = cache();
    if (c[lote]) return c[lote];
    const tabla = await tablaDeLote(lote, 'REVISADO', 'revisado por');
    const filas = tabla ? tablaAFilas(tabla).map(f => filaRevisado(f, lote)).filter(f => f.cheque) : [];
    const masNueva = filas.reduce((m, f) => (f.fecha > m ? f.fecha : m), '');
    if (masNueva && masNueva < iso(sumarDias(new Date(), -3))) { c[lote] = filas; }
    return filas;
  }

  // Pendientes de un lote (nunca se guardan en caché: cambian cuando se revisan).
  // El valor exacto de "estado" se aprende la primera vez que devuelve una tabla.
  const ESTADOS_PEND = ['PENDIENTE']; // confirmado: ...&documento=1001503&estado=PENDIENTE
  async function pendientesDeLote(lote) {
    const aprendido = GM_getValue('lf_estado_pend', null);
    for (const est of aprendido ? [aprendido] : ESTADOS_PEND) {
      const tabla = await tablaDeLote(lote, est, 'cheque/transferencia');
      if (tabla) {
        if (!aprendido) GM_setValue('lf_estado_pend', est);
        return tablaAFilas(tabla).map(f => {
          const r = filaRevisado(f, lote);
          r.quien_revisa = campo(f, 'persona') || r.revisado_por || '(sin asignar)';
          delete r.revisado_por;
          return r;
        }).filter(f => f.cheque);
      }
    }
    return [];
  }

  // Encuentra el lote más reciente subiendo desde el último conocido
  async function ultimoLote() {
    aprenderLote();
    let n = GM_getValue('lf_ultimo_lote', LOTE_INICIAL), vacios = 0, prueba = n;
    while (vacios < 5 && prueba < n + 200) {
      prueba++;
      const filas = await revisadosDeLote(prueba);
      if (filas.length) { n = prueba; vacios = 0; } else vacios++;
    }
    GM_setValue('lf_ultimo_lote', n);
    return n;
  }

  async function revisadosHistorico(intento) {
    let filas = [];
    const pend = intento.estado === 'PENDIENTE';
    if (intento.lote) {
      filas = pend ? await pendientesDeLote(Number(intento.lote)) : await revisadosDeLote(Number(intento.lote));
      intento.rango = null;
    } else {
      const hoy = iso(new Date());
      const desde = intento.desde || iso(restarMeses(new Date(), 1));
      const hasta = intento.hasta || hoy;
      let lote = await ultimoLote();
      let viejos = 0, vacios = 0, revisados = 0;
      const tam = 6;
      while (lote > 0 && viejos < 2 && vacios < 40 && revisados < 3000) {
        const grupo = Array.from({ length: tam }, (_, i) => lote - i);
        progreso(`Revisando lotes ${grupo.at(-1)} a ${grupo[0]}…`);
        // La fecha de cada lote sale de sus revisados (en caché); los datos, del estado pedido
        const res = await Promise.all(grupo.map(async l => {
          const rev = await revisadosDeLote(l);
          return { rev, datos: pend ? await pendientesDeLote(l) : rev };
        }));
        let todosViejos = true, hayDatos = false;
        res.forEach(({ rev, datos }) => {
          const todo = rev.concat(pend ? datos : []);
          if (!todo.length) { vacios++; return; }
          vacios = 0; hayDatos = true;
          const masNueva = todo.reduce((m, f) => (f.fecha > m ? f.fecha : m), '');
          if (masNueva >= desde) todosViejos = false;
          filas = filas.concat(datos.filter(f => f.fecha >= desde && f.fecha <= hasta));
        });
        viejos = hayDatos && todosViejos ? viejos + 1 : 0;
        revisados += tam;
        lote -= tam;
      }
      progreso(null);
      guardarCache();
      intento.rango = { desde, hasta, lotes: revisados };
    }
    if (intento.persona) {
      const partes = norm(intento.persona).split(/\s+/).filter(x => x.length > 2).slice(0, 2);
      filas = filas.filter(f => partes.every(x => norm(f.revisado_por || f.quien_revisa).includes(x)));
    }
    if (intento.receptor) {
      const partes = norm(intento.receptor).split(/\s+/).filter(x => x.length > 1);
      filas = filas.filter(f => partes.every(x => norm(f.receptor).includes(x)));
    }
    return filas;
  }

  // Mientras no se conecte el histórico: lee la tabla REVISADO abierta en pantalla
  function revisadosDesdePantalla(intento) {
    const tabla = tablaConColumna(document, 'revisado por');
    if (!tabla) {
      throw new Error('La consulta de revisados todavía no está conectada al histórico. Mientras tanto: abre "Histórico expdte. para revisión", pulsa "Revisados" en un lote y vuelve a preguntar (busco en esa tabla). Para conectarla, mándame el log o la dirección que sale en la barra al pulsar "Revisados".');
    }
    intento.soloPantalla = true;
    let filas = tablaAFilas(tabla).map(f => ({
      fecha: campoTexto(f, 'fecha'),
      revisado_por: campoTexto(f, 'revisado por'),
      sociedad: nombreSociedad(campoTexto(f, 'sociedad')),
      receptor: campoTexto(f, 'receptor del pago'),
      cheque: campoTexto(f, 'cheque/transferencia'),
      documento: campoTexto(f, 'documento pago'),
      moneda: campoTexto(f, 'moneda'),
      importe: campoTexto(f, 'importe'),
      emisor: campoTexto(f, 'emisor'),
    })).filter(f => f.cheque);
    if (intento.desde) filas = filas.filter(f => !f.fecha || (f.fecha >= intento.desde && f.fecha <= intento.hasta));
    if (intento.persona) {
      const partes = norm(intento.persona).split(/\s+/).filter(x => x.length > 2).slice(0, 2);
      filas = filas.filter(f => partes.every(x => norm(f.revisado_por).includes(x)));
    }
    if (intento.receptor) {
      const partes = norm(intento.receptor).split(/\s+/).filter(x => x.length > 1);
      filas = filas.filter(f => partes.every(x => norm(f.receptor).includes(x)));
    }
    return filas;
  }

  function totalesPorMoneda(filas) {
    const t = {};
    filas.forEach(f => { const v = Number(String(f.importe).replace(/,/g, '')) || 0; t[f.moneda || '?'] = (t[f.moneda || '?'] || 0) + v; });
    return Object.entries(t).map(([m, v]) => `${m} ${v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`).join(' · ');
  }

  // Días hábiles (lunes a viernes) entre desde y hasta, del más reciente al más viejo
  function diasHabiles(desde, hasta) {
    const out = [];
    const d = new Date(hasta + 'T12:00:00'), fin = new Date(desde + 'T12:00:00');
    while (d >= fin && out.length < 400) {
      if (d.getDay() !== 0 && d.getDay() !== 6) out.push(iso(d));
      d.setDate(d.getDate() - 1);
    }
    return out;
  }

  function tablaConColumna(doc, columna) {
    return [...doc.querySelectorAll('table')].find(t =>
      [...t.querySelectorAll('th')].some(th => norm(th.textContent) === columna)) || null;
  }

  // Descarga el reporte de una fecha. Aprende la página base que funciona.
  async function reporteDeFecha(fecha) {
    const c = CONECTORES.pagos_pendientes;
    const aprendida = GM_getValue('lf_form_url_' + c.accion, null);
    const bases = [...new Set([aprendida, GM_getValue('lf_base_revision', null), '/modulo/dashboard.php', location.pathname,
      '/modulo/index.php', '/modulo/', '/index.php', '/'].filter(Boolean))];
    for (const base of bases) {
      const url = absoluta(c.url.replace('{base}', base).replace('{fecha}', fecha));
      const resp = await fetchOriginal.call(W, url, { credentials: 'include' });
      if (!resp.ok) continue;
      const texto = await resp.text();
      registrar({ t: new Date().toISOString(), via: 'bot', metodo: 'GET', url, cuerpo: '', status: resp.status, tipo: 'html', muestra: muestra(texto) });
      const tabla = tablaConColumna(new DOMParser().parseFromString(texto, 'text/html'), c.columnaClave);
      if (tabla) {
        GM_setValue('lf_base_revision', base);
        return tablaAFilas(tabla).filter(f => campoTexto(f, 'cheque')).map(f => ({ fecha_reporte: fecha, ...f }));
      }
    }
    throw new Error('No pude abrir el reporte "Acuse expdte. para revisar". Abre esa pantalla una vez con el Explorador encendido, pulsa Buscar y vuelve a preguntar.');
  }

  function campoTexto(f, nombre) {
    const k = Object.keys(f).find(x => norm(x) === nombre);
    return k ? String(f[k]).trim() : '';
  }

  // Recorre las fechas (por defecto los últimos 15 días) y junta los acuses
  async function pagosPorFechas(intento) {
    const hoy = iso(new Date());
    const desde = intento.desde || iso(restarMeses(new Date(), 1)); // por defecto: el último mes
    const hasta = (intento.hasta || hoy) > hoy ? hoy : (intento.hasta || hoy);
    const dias = diasHabiles(desde, hasta);
    let filas = [];
    for (let i = 0; i < dias.length; i += 6) {
      if (ui.mensajes && dias.length > 25) progreso(`Revisando ${Math.min(i + 6, dias.length)} de ${dias.length} días…`);
      const lote = await Promise.all(dias.slice(i, i + 6).map(reporteDeFecha));
      lote.forEach(x => { filas = filas.concat(x); });
    }
    progreso(null);
    intento.rango = { desde, hasta, dias: dias.length };
    if (intento.persona) {
      const partes = norm(intento.persona).split(/\s+/).filter(x => x.length > 2).slice(0, 2);
      filas = filas.filter(f => { const txt = norm(campo(f, 'persona') || Object.values(f).join(' ')); return partes.every(x => txt.includes(x)); });
    }
    // Columnas útiles, en orden, con el nombre de la sociedad
    let salida = filas.map(f => ({
      fecha: f.fecha_reporte,
      quien_revisa: campo(f, 'persona') || '(sin asignar)',
      sociedad: nombreSociedad(campoTexto(f, 'soc.')),
      cheque: campoTexto(f, 'cheque'),
      doc: campoTexto(f, 'doc.'),
      importe: campoTexto(f, 'importe'),
      moneda: campoTexto(f, 'moneda'),
      receptor: campoTexto(f, 'receptor del pago'),
      emisor: campoTexto(f, 'emisor'),
    }));
    if (intento.sinAsignar) salida = salida.filter(f => f.quien_revisa === '(sin asignar)');
    if (intento.receptor) {
      const partes = norm(intento.receptor).split(/\s+/).filter(x => x.length > 1);
      salida = salida.filter(f => { const r = norm(f.receptor); return partes.every(x => r.includes(x)); });
    }
    return salida;
  }

  // Agrupa filas por persona y fecha: [{persona, fecha, pagos}]
  function agruparPagos(filas) {
    const mapa = {};
    filas.forEach(f => {
      const fecha = String(f.fecha || campo(f, 'fecha') || '(sin fecha)').slice(0, 10);
      const persona = f.quien_revisa || campo(f, 'persona') || '(sin asignar)';
      const k = persona + '|' + fecha;
      mapa[k] = mapa[k] || { persona, fecha, acuses: 0 };
      mapa[k].acuses++;
    });
    return Object.values(mapa).sort((a, b) => a.persona.localeCompare(b.persona) || a.fecha.localeCompare(b.fecha));
  }

  function consultarTablaVisible(intento) {
    const tablas = [...document.querySelectorAll('table')].filter(t => t.offsetParent !== null && !t.closest('#lf-asistente'));
    if (!tablas.length) throw new Error('No veo ninguna tabla en esta pantalla.');
    const tabla = tablas.sort((a, b) => b.querySelectorAll('tr').length - a.querySelectorAll('tr').length)[0];
    let filas = tablaAFilas(tabla);
    if (intento.termino) {
      const t = norm(intento.termino);
      filas = filas.filter(f => Object.values(f).some(v => norm(v).includes(t)));
    }
    return filas.slice(0, CONFIG.maxFilas);
  }

  // ───────────────────────── 4. FORMATEADOR ─────────────────────────
  function campo(fila, tipo) {
    const claves = Object.keys(fila);
    const candidatos = CAMPOS[tipo] || [];
    const k = claves.find(c => candidatos.includes(norm(c).replace(/[^a-z0-9]/g, '')));
    return k ? fila[k] : undefined;
  }

  function conteoPor(filas, tipo) {
    const mapa = {};
    filas.forEach(f => { const v = campo(f, tipo) || '(sin dato)'; mapa[v] = (mapa[v] || 0) + 1; });
    return Object.entries(mapa).sort((a, b) => b[1] - a[1]).map(([valor, cantidad]) => ({ [tipo]: valor, cantidad }));
  }

  function resumir(intento, filas) {
    const n = filas.length;
    const tope = n >= CONFIG.maxFilas ? ` (se muestran las primeras ${CONFIG.maxFilas})` : '';
    switch (intento.intencion) {
      case 'ubicacion': {
        if (!n) {
          const donde = intento.sociedad ? `la sociedad ${nombreSociedad(intento.sociedad)}` : `ninguna de las ${sociedadesConocidas().length} sociedades`;
          return { texto: `No encontré el cheque ${intento.expediente} en ${donde}. Si es de otra sociedad, pregunta así: "¿Dónde está el cheque ${intento.expediente} sociedad 0045?"` };
        }
        if (n > 1) return { texto: `El cheque ${intento.expediente} aparece en ${n} sociedades:`, filas: filas.map(d => ({ sociedad: nombreSociedad(d.sociedad), caja: d.caja, ubicacion: d.ubicacion, estado: d.estado, beneficiario: d.beneficiario })) };
        const d = filas[0];
        const partes = [`El cheque ${d.cheque || intento.expediente} está en la caja ${d.caja || '(sin caja)'}`];
        if (d.ubicacion) partes.push(`, ${d.ubicacion}`);
        partes.push(`. Estado: ${d.estado || 'sin dato'}`);
        if (d.prestado_a) partes.push(`, prestado a ${d.prestado_a}`);
        partes.push(`. Sociedad ${nombreSociedad(d.sociedad)}.`);
        const detalle = ['sociedad', 'cheque', 'fecha', 'documento', 'beneficiario', 'moneda', 'importe', 'caja', 'ubicacion', 'estado', 'prestado_a']
          .filter(k => k in d).reduce((o, k) => (o[k] = d[k], o), {});
        return { texto: partes.join(''), filas: [detalle] };
      }
      case 'contenido_caja':
        return { texto: `La caja ${intento.caja} tiene ${n} expediente(s)${tope}.`, filas: intento.soloConteo ? null : filas };
      case 'asignados':
        return { texto: `${intento.persona} tiene ${n} expediente(s) asignado(s)${tope}.`, filas: intento.soloConteo ? conteoPor(filas, 'estado') : filas };
      case 'pagos_pendientes': {
        const quien = intento.persona || 'El equipo';
        const r = intento.rango ? ` (revisé ${intento.rango.dias} días hábiles, del ${intento.rango.desde} al ${intento.rango.hasta})` : '';
        if (intento.sinAsignar) {
          return n
            ? { texto: `Hay ${n} expediente(s) sin asignar (sin nombre en "Quien revisa?")${r}.`, filas }
            : { texto: `No hay expedientes sin asignar${r}.` };
        }
        if (intento.receptor) {
          if (!n) return { texto: `No encontré acuses pendientes con receptor del pago "${intento.receptor.toUpperCase()}"${r}.` };
          const nombres = [...new Set(filas.map(f => f.receptor))];
          return { texto: `${n} acuse(s) pendiente(s) con receptor del pago ${nombres.slice(0, 3).join(', ')}${nombres.length > 3 ? '…' : ''}${r}. ` + resumenPersonas(filas), filas };
        }
        if (!n) return { texto: `${quien} no tiene acuses pendientes${r}.` };
        const grupos = agruparPagos(filas);
        const fechas = [...new Set(grupos.map(g => g.fecha))];
        const texto = intento.persona
          ? `${quien} tiene ${n} acuse(s) pendiente(s) en ${fechas.length} fecha(s): ${fechas.slice(0, 6).join(', ')}${fechas.length > 6 ? '…' : ''}${r}.`
          : `${n} acuse(s) pendiente(s) en ${fechas.length} fecha(s)${r}. ` + resumenPersonas(filas);
        return { texto, filas: intento.soloConteo ? grupos : (intento.persona ? filas : grupos) };
      }
      case 'revisados': {
        const fuente = intento.lote ? ` en el lote ${intento.lote}`
          : intento.rango ? ` del ${intento.rango.desde} al ${intento.rango.hasta} (revisé ${intento.rango.lotes} lotes)` : '';
        const quien = intento.receptor ? `de ${intento.receptor.toUpperCase()}` : intento.persona ? `por ${intento.persona}` : '';
        const pend = intento.estado === 'PENDIENTE';
        const palabra = pend ? 'pendiente(s)' : 'revisado(s)';
        if (!n) return { texto: `No encontré pagos ${pend ? 'pendientes' : 'revisados'}${quien ? " " + quien : ""}${fuente}.` };
        const porPersona = {};
        filas.forEach(f => { const p = f.revisado_por || f.quien_revisa || '(sin asignar)'; porPersona[p] = (porPersona[p] || 0) + 1; });
        const reparto = Object.entries(porPersona).map(([p, k]) => `${p}: ${k}`).join(' · ');
        return { texto: `${n} pago(s) ${palabra}${quien ? " " + quien : ""}${fuente}. Total: ${totalesPorMoneda(filas)}. ${pend ? 'Quien revisa' : 'Revisado por'}: ${reparto}.`, filas: intento.soloConteo ? null : filas };
      }
      case 'pendientes_descargo':
        return { texto: `${intento.persona} tiene ${n} expediente(s) pendiente(s) de descargo${tope}.`, filas: intento.soloConteo ? null : filas };
      case 'por_estado':
        return intento.estado
          ? { texto: `Hay ${n} expediente(s) en estado "${intento.estado}"${tope}.`, filas: intento.soloConteo ? null : filas }
          : { texto: `Conteo por estado sobre ${n} expediente(s)${tope}:`, filas: conteoPor(filas, 'estado') };
      case 'por_fecha': {
        const rango = intento.desde === intento.hasta ? `el ${intento.desde}` : `del ${intento.desde} al ${intento.hasta}`;
        return { texto: `${n} expediente(s) ${intento.movimiento || 'con movimiento'} ${rango}${tope}.`, filas: intento.soloConteo ? conteoPor(filas, 'estado') : filas };
      }
      case 'historial':
        return { texto: n ? `Historial del cheque ${intento.expediente}: ${n} registro(s).` : `No encontré el cheque ${intento.expediente}.`, filas };
      case 'tabla_visible':
        return { texto: intento.termino ? `${n} fila(s) de la tabla contienen "${intento.termino}".` : `La tabla visible tiene ${n} fila(s).`, filas: intento.soloConteo ? null : filas };
      default:
        return { texto: 'Listo.', filas };
    }
  }

  function aCSV(filas) {
    const cols = [...new Set(filas.flatMap(f => Object.keys(f)))];
    const esc = v => `"${String(v == null ? '' : typeof v === 'object' ? JSON.stringify(v) : v).replace(/"/g, '""')}"`;
    return '﻿' + [cols.map(esc).join(','), ...filas.map(f => cols.map(c => esc(f[c])).join(','))].join('\r\n');
  }

  function descargar(nombre, contenido, tipo) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([contenido], { type: tipo }));
    a.download = nombre;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  }

  // ───────────────────────── 5. PANEL DE CHAT ─────────────────────────
  const AYUDA = [
    '¿Dónde está el cheque CIT3822570192?',
    '¿Quién consultó el cheque CIT3822570192?',
    '¿Qué hay en la caja C-0123?',
    '¿Qué pagos debe Juana Reyes y en qué fechas?',
    '¿Quiénes deben pagos en los últimos 3 meses?',
    'Expedientes sin asignar',
    'CENTRO CUESTA NACIONAL revisados en los últimos 6 meses',
    'Seguro Reservas pendientes en los últimos 3 meses',
    '¿Cuántos pagos ha revisado Yeny Abreu Guzmán este mes?',
    'Pagos de BASICORP SRL en octubre',
    '¿Qué pagos debe Juana Reyes en septiembre 2026?',
    '¿Cuántos pendientes de descargo tiene Juan Gómez?',
    '¿Cuántos expedientes hay por estado?',
    '¿Qué se recibió esta semana?',
    'En esta tabla busca 2026',
  ];

  let ui = {};

  function actualizarContadorLog() {
    if (ui.contador) ui.contador.textContent = `${log.length} llamadas`;
  }

  function el(tag, attrs, ...hijos) {
    const e = document.createElement(tag);
    Object.entries(attrs || {}).forEach(([k, v]) => (k === 'style' ? (e.style.cssText = v) : k.startsWith('on') ? e.addEventListener(k.slice(2), v) : e.setAttribute(k, v)));
    hijos.flat().forEach(h => e.append(h instanceof Node ? h : document.createTextNode(String(h))));
    return e;
  }

  function mensaje(quien, contenido) {
    const burbuja = el('div', { class: `lf-msg lf-${quien}` });
    burbuja.append(contenido instanceof Node ? contenido : document.createTextNode(contenido));
    ui.mensajes.append(burbuja);
    ui.mensajes.scrollTop = ui.mensajes.scrollHeight;
  }

  function progreso(texto) {
    if (!ui.progreso) { ui.progreso = el('div', { class: 'lf-msg lf-bot lf-nota' }); }
    if (!texto) { ui.progreso.remove(); return; }
    ui.progreso.textContent = texto;
    ui.mensajes.append(ui.progreso);
    ui.mensajes.scrollTop = ui.mensajes.scrollHeight;
  }

  function tablaHTML(filas) {
    const cols = [...new Set(filas.slice(0, CONFIG.filasVisibles).flatMap(f => Object.keys(f)))].slice(0, 8);
    const t = el('table', { class: 'lf-tabla' },
      el('thead', {}, el('tr', {}, cols.map(c => el('th', {}, c)))),
      el('tbody', {}, filas.slice(0, CONFIG.filasVisibles).map(f => el('tr', {}, cols.map(c => el('td', {}, f[c] == null ? '' : typeof f[c] === 'object' ? JSON.stringify(f[c]) : f[c]))))));
    const caja = el('div', {}, el('div', { class: 'lf-scroll' }, t));
    if (filas.length > CONFIG.filasVisibles) caja.append(el('div', { class: 'lf-nota' }, `Se muestran ${CONFIG.filasVisibles} de ${filas.length}. Descarga el CSV para verlas todas.`));
    caja.append(el('button', { class: 'lf-btn', onclick: () => descargar(`looking-for-${Date.now()}.csv`, aCSV(filas), 'text/csv;charset=utf-8') }, 'Descargar CSV'));
    return caja;
  }

  async function responder(pregunta, intentoDirecto) {
    mensaje('yo', pregunta);
    const intento = intentoDirecto || interpretar(pregunta);
    if (intento.intencion === 'desconocida') {
      mensaje('bot', el('div', {}, 'No entendí la pregunta. Prueba con algo como:', el('ul', {}, AYUDA.map(a => el('li', {}, a)))));
      return;
    }
    try {
      const filas = intento.intencion === 'tabla_visible' ? consultarTablaVisible(intento) : await consultar(intento);
      const r = resumir(intento, filas);
      const cont = el('div', {}, el('div', {}, r.texto));
      if (r.filas && r.filas.length) cont.append(tablaHTML(r.filas));
      mensaje('bot', cont);
    } catch (e) {
      mensaje('bot', `⚠ ${e.message}`);
    }
  }

  function construirPanel() {
    const estilo = el('style', {}, `
      #lf-asistente{position:fixed;right:16px;bottom:16px;z-index:2147483646;font:13px/1.4 system-ui,Segoe UI,Arial,sans-serif;color:#1f2328}
      #lf-asistente .lf-fab{width:52px;height:52px;border-radius:50%;border:0;background:#1f6feb;color:#fff;font-weight:700;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.25)}
      #lf-asistente .lf-panel{display:none;flex-direction:column;width:440px;max-width:calc(100vw - 32px);height:560px;max-height:calc(100vh - 90px);background:#fff;border:1px solid #d0d7de;border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.2);margin-bottom:8px;overflow:hidden}
      #lf-asistente.abierto .lf-panel{display:flex}
      #lf-asistente .lf-head{padding:10px 12px;background:#f6f8fa;border-bottom:1px solid #d0d7de;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
      #lf-asistente .lf-head b{flex:1}
      #lf-asistente .lf-mensajes{flex:1;overflow:auto;padding:10px;display:flex;flex-direction:column;gap:8px}
      #lf-asistente .lf-msg{padding:8px 10px;border-radius:8px;max-width:100%;word-wrap:break-word}
      #lf-asistente .lf-yo{align-self:flex-end;background:#ddf4ff}
      #lf-asistente .lf-bot{align-self:flex-start;background:#f6f8fa;width:100%;box-sizing:border-box}
      #lf-asistente .lf-scroll{overflow:auto;max-height:240px;margin:6px 0}
      #lf-asistente .lf-tabla{border-collapse:collapse;font-size:12px}
      #lf-asistente .lf-tabla th,#lf-asistente .lf-tabla td{border:1px solid #d0d7de;padding:3px 6px;text-align:left;white-space:nowrap}
      #lf-asistente .lf-tabla th{background:#eaeef2}
      #lf-asistente .lf-nota{font-size:11px;color:#57606a}
      #lf-asistente .lf-btn{border:1px solid #d0d7de;background:#fff;border-radius:6px;padding:4px 8px;cursor:pointer;font-size:12px}
      #lf-asistente .lf-btn.on{background:#fff8c5;border-color:#d4a72c}
      #lf-asistente form{display:flex;gap:6px;padding:8px;border-top:1px solid #d0d7de}
      #lf-asistente .lf-personas{display:flex;gap:6px;padding:8px;border-bottom:1px solid #d0d7de;flex-wrap:wrap;align-items:center}
      #lf-asistente select{flex:1;min-width:130px;padding:6px;border:1px solid #d0d7de;border-radius:6px;font:inherit}
      #lf-asistente input{flex:1;padding:8px;border:1px solid #d0d7de;border-radius:6px;font:inherit}
    `);
    ui.contador = el('span', { class: 'lf-nota' });
    ui.btnExplorar = el('button', { class: 'lf-btn', type: 'button', onclick: () => {
      explorando = !explorando; GM_setValue(ON_KEY, explorando); pintarExplorador();
      mensaje('bot', explorando ? 'Explorador activado: usa Looking For normal y luego exporta el log.' : 'Explorador desactivado.');
    } });
    const btnExportar = el('button', { class: 'lf-btn', type: 'button', onclick: () => descargar(`looking-for-log-${Date.now()}.json`, JSON.stringify(log, null, 2), 'application/json') }, 'Exportar log');
    const btnLimpiar = el('button', { class: 'lf-btn', type: 'button', onclick: () => { log = []; GM_setValue(LOG_KEY, log); actualizarContadorLog(); } }, 'Limpiar');
    ui.mensajes = el('div', { class: 'lf-mensajes' });
    const entrada = el('input', { placeholder: 'Pregunta sobre expedientes, cajas, asignaciones…' });
    const form = el('form', { onsubmit: ev => { ev.preventDefault(); const t = entrada.value.trim(); if (t) { entrada.value = ''; responder(t); } } },
      entrada, el('button', { class: 'lf-btn', type: 'submit' }, 'Enviar'));
    const selPersona = el('select', { title: 'Persona que revisa expedientes' },
      el('option', { value: '' }, 'Todas las personas'),
      el('option', { value: '__sin__' }, '(Sin asignar)'),
      CONFIG.revisores.map(r => el('option', { value: r }, r)));
    const selPeriodo = el('select', { title: 'Período a revisar' },
      el('option', { value: '1' }, 'Último mes'),
      el('option', { value: '3' }, 'Últimos 3 meses'),
      el('option', { value: 'n' }, 'Cantidad de meses…'),
      el('option', { value: 'mes' }, 'Un mes específico…'));
    const inCant = el('input', { type: 'number', min: '1', max: '24', value: '6', title: 'Cantidad de meses hacia atrás', style: 'display:none;flex:0 0 70px' });
    const inMes = el('input', { type: 'month', style: 'display:none;flex:0 0 150px', value: iso(new Date()).slice(0, 7) });
    selPeriodo.addEventListener('change', () => {
      inMes.style.display = selPeriodo.value === 'mes' ? '' : 'none';
      inCant.style.display = selPeriodo.value === 'n' ? '' : 'none';
    });
    const periodo = () => {
      const hoy = new Date();
      if (selPeriodo.value === 'mes' && inMes.value) {
        const [a, m] = inMes.value.split('-').map(Number);
        return { ...rangoDeMes(a, m - 1), etiqueta: `en ${inMes.value}` };
      }
      const k = selPeriodo.value === 'n' ? Math.min(24, Math.max(1, Math.round(Number(inCant.value) || 1))) : Number(selPeriodo.value);
      return { desde: iso(restarMeses(hoy, k)), hasta: iso(hoy), etiqueta: k === 1 ? 'en el último mes' : `en los últimos ${k} meses` };
    };
    const accion = (intencion, frase) => () => {
      const sinAsignar = selPersona.value === '__sin__';
      const persona = sinAsignar ? null : (selPersona.value || null);
      if (!persona && intencion !== 'pagos_pendientes') { mensaje('bot', 'Elige una persona en la lista.'); return; }
      const per = intencion === 'pagos_pendientes' ? periodo() : {};
      const texto = sinAsignar ? 'Expedientes sin asignar' : frase(persona || 'todas las personas');
      responder(texto + (per.etiqueta ? ` (${per.etiqueta})` : ''),
        { intencion, persona, sinAsignar, soloConteo: false, desde: per.desde, hasta: per.hasta });
    };
    const barraPersonas = el('div', { class: 'lf-personas' }, selPersona, selPeriodo, inCant, inMes,
      el('button', { class: 'lf-btn', type: 'button', onclick: accion('pagos_pendientes', p => `¿Qué pagos deben ${p} y en qué fechas?`) }, 'Pagos pendientes'),
      el('button', { class: 'lf-btn', type: 'button', onclick: accion('pendientes_descargo', p => `¿Qué pendientes de descargo tiene ${p}?`) }, 'Descargo'),
      el('button', { class: 'lf-btn', type: 'button', onclick: accion('asignados', p => `¿Qué tiene asignado ${p}?`) }, 'Asignados'));
    const panel = el('div', { class: 'lf-panel' },
      el('div', { class: 'lf-head' }, el('b', {}, 'Asistente Looking For'), ui.btnExplorar, btnExportar, btnLimpiar, ui.contador),
      barraPersonas, ui.mensajes, form);
    const raiz = el('div', { id: 'lf-asistente' }, panel,
      el('div', { style: 'text-align:right' }, el('button', { class: 'lf-fab', title: 'Asistente Looking For', onclick: () => { raiz.classList.toggle('abierto'); entrada.focus(); } }, 'LF?')));
    document.head.append(estilo);
    document.body.append(raiz);
    pintarExplorador();
    actualizarContadorLog();
    mensaje('bot', el('div', {}, 'Hola. Solo leo datos, nunca modifico nada. Ejemplos:', el('ul', {}, AYUDA.map(a => el('li', {}, a)))));
  }

  function pintarExplorador() {
    ui.btnExplorar.textContent = explorando ? 'Explorador: ON' : 'Explorador: OFF';
    ui.btnExplorar.classList.toggle('on', explorando);
  }

  W.addEventListener('load', aprenderLote);
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', construirPanel);
  else construirPanel();
})();
