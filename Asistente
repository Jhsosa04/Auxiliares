/*
  CÓMO USARLO
  1. Cambia la línea @match por la dirección real de Looking For (ej. https://lookingfor.miempresa.com/*).
  2. Fase 0: abre el panel (botón "LF?" abajo a la derecha), activa "Explorador" y usa Looking For normal:
     busca un expediente, abre una caja, filtra asignados, filtra por fecha. Luego "Exportar log".
  3. Con el log se llenan las URLs del bloque CONECTORES. Mientras tanto ya funciona la pregunta
     "en esta tabla ..." sobre cualquier tabla visible en pantalla.
*/

(function () {
  'use strict';

  const W = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;

  // ───────────────────────── CONFIGURACIÓN ─────────────────────────
  const CONFIG = {
    maxFilas: 500,       // tope de filas por respuesta
    filasVisibles: 50,   // filas que se pintan en el chat (el CSV lleva todas)
    maxLog: 300,         // llamadas que guarda el explorador
    // Sociedades donde buscar un cheque cuando la pregunta no dice cuál (0001 Consolidación se excluye).
