// ==UserScript==
// @name         Bot Caja - Acuse expdte. para archivo
// @namespace    jhon-sosa
// @version      1.0
// @description  Coloca la caja indicada en cada expediente pendiente, presiona Aceptar y espera 1 segundo entre filas.
// @match        *://*/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(function () {
  'use strict';

  // ---------- Configuración ----------
  const TITULO_PAGINA = 'Acuse expdte. para archivo'; // el bot solo aparece en esta pantalla
  const ESPERA_MS = 1000;                               // espera después de cada "Aceptar"
  const CLAVE = 'botCaja.estado';

  // ---------- Utilidades ----------
  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
  const norm = (t) => (t || '').replace(/\s+/g, ' ').trim().toLowerCase();

  const leerEstado = () => {
    try { return JSON.parse(sessionStorage.getItem(CLAVE)) || {}; } catch { return {}; }
  };
  const guardarEstado = (e) => {
    try { sessionStorage.setItem(CLAVE, JSON.stringify(e)); } catch { /* sin almacenamiento */ }
  };

  const esPaginaCorrecta = () =>
    document.body && document.body.innerText.includes(TITULO_PAGINA);

  // Busca la tabla que tiene la columna "Caja"
  function encontrarTabla() {
    return [...document.querySelectorAll('table')].find((t) =>
      [...t.querySelectorAll('th')].some((th) => norm(th.textContent) === 'caja')
    );
  }

  function indices(tabla) {
    const filaEnc = [...tabla.rows].find((r) => r.querySelector('th'));
    const celdas = filaEnc ? [...filaEnc.cells] : [];
    const idx = (nombre) => celdas.findIndex((c) => norm(c.textContent) === nombre);
    return { id: idx('id'), caja: idx('caja'), accion: idx('acción') !== -1 ? idx('acción') : idx('accion') };
  }

  // Devuelve la siguiente fila pendiente: casilla Caja vacía y botón Aceptar disponible
  function siguienteFila(tabla, procesados) {
    const ix = indices(tabla);
    if (ix.caja === -1) return null;

    const filas = [...tabla.rows].filter((r) => r.querySelector('td'));
    for (const tr of filas) {
      if (tr.dataset.botHecho) continue;

      const id = ix.id !== -1 && tr.cells[ix.id] ? tr.cells[ix.id].textContent.trim() : '';
      if (id && procesados.includes(id)) continue;

      const input = tr.cells[ix.caja] && tr.cells[ix.caja].querySelector('input');
      if (!input || input.disabled || input.readOnly || input.value.trim() !== '') continue;

      const zonaBoton = (ix.accion !== -1 && tr.cells[ix.accion]) || tr;
      const boton = [...zonaBoton.querySelectorAll('button, input[type="button"], input[type="submit"], a')]
        .find((b) => norm(b.textContent || b.value) === 'aceptar');
      if (!boton || boton.disabled) continue;

      return { tr, id, input, boton };
    }
    return null;
  }

  // Escribe el valor de forma que el sistema lo detecte (funciona también con React/Angular/Vue)
  function escribir(input, valor) {
    const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set;
    input.focus();
    setter.call(input, valor);
    input.dispatchEvent(new Event('input', { bubbles: true }));
    input.dispatchEvent(new Event('change', { bubbles: true }));
    input.blur();
  }

  function contarPendientes() {
    const tabla = encontrarTabla();
    if (!tabla) return 0;
    const ix = indices(tabla);
    return [...tabla.rows].filter((r) => {
      const inp = r.cells[ix.caja] && r.cells[ix.caja].querySelector('input');
      return inp && inp.value.trim() === '';
    }).length;
  }

  // ---------- Panel ----------
  let panel, campoCaja, btnIniciar, btnDetener, txtEstado;

  function crearPanel() {
    panel = document.createElement('div');
    panel.id = 'bot-caja-panel';
    panel.innerHTML = `
      <style>
        #bot-caja-panel{position:fixed;right:16px;bottom:16px;z-index:999999;width:250px;
          background:#fff;color:#1d2b22;border:2px solid #0aa84f;border-radius:8px;
          box-shadow:0 6px 18px rgba(0,0,0,.18);font:14px/1.4 system-ui,Segoe UI,Arial,sans-serif;padding:12px}
        #bot-caja-panel h4{margin:0 0 8px;font-size:15px;color:#08843e}
        #bot-caja-panel label{display:block;font-size:13px;margin-bottom:4px}
        #bot-caja-panel input{width:100%;box-sizing:border-box;padding:6px 8px;border:1px solid #b9c7bf;border-radius:4px;font-size:15px}
        #bot-caja-panel input:focus{outline:2px solid #0aa84f;outline-offset:1px}
        #bot-caja-panel .fila{display:flex;gap:6px;margin-top:8px}
        #bot-caja-panel button{flex:1;padding:7px;border:0;border-radius:4px;cursor:pointer;font-weight:600}
        #bot-caja-panel button:focus-visible{outline:2px solid #1d2b22;outline-offset:2px}
        #bot-caja-panel .ini{background:#0aa84f;color:#fff}
        #bot-caja-panel .det{background:#e8ecea;color:#1d2b22}
        #bot-caja-panel button:disabled{opacity:.5;cursor:default}
        #bot-caja-panel .estado{margin-top:8px;font-size:13px;color:#3d4d44;min-height:18px}
      </style>
      <h4>Bot de cajas</h4>
      <label for="bot-caja-valor">Caja a asignar</label>
      <input id="bot-caja-valor" type="text" placeholder="Ej.: C-428" autocomplete="off">
      <div class="fila">
        <button class="ini" type="button">Iniciar</button>
        <button class="det" type="button" disabled>Detener</button>
      </div>
      <div class="estado" aria-live="polite"></div>`;
    document.body.appendChild(panel);

    campoCaja = panel.querySelector('#bot-caja-valor');
    btnIniciar = panel.querySelector('.ini');
    btnDetener = panel.querySelector('.det');
    txtEstado = panel.querySelector('.estado');

    btnIniciar.addEventListener('click', iniciar);
    btnDetener.addEventListener('click', () => detener('Detenido por el usuario.'));
    campoCaja.addEventListener('keydown', (e) => { if (e.key === 'Enter') iniciar(); });
  }

  function refrescarPanel(mensaje) {
    const e = leerEstado();
    btnIniciar.disabled = !!e.activo;
    btnDetener.disabled = !e.activo;
    campoCaja.disabled = !!e.activo;
    if (e.caja) campoCaja.value = e.caja;
    if (mensaje !== undefined) txtEstado.textContent = mensaje;
  }

  // ---------- Lógica principal ----------
  function iniciar() {
    const caja = campoCaja.value.trim();
    if (!caja) { txtEstado.textContent = 'Escribe la caja antes de iniciar.'; campoCaja.focus(); return; }

    const pendientes = contarPendientes();
    if (!pendientes) { txtEstado.textContent = 'No hay casillas de caja vacías en pantalla.'; return; }

    if (!confirm(`Se asignará la caja "${caja}" a ${pendientes} expediente(s) visibles y se presionará Aceptar en cada uno.\n\n¿Continuar?`)) return;

    guardarEstado({ activo: true, caja, procesados: [], total: 0 });
    refrescarPanel('Iniciando…');
    ejecutar();
  }

  function detener(mensaje) {
    const e = leerEstado();
    e.activo = false;
    guardarEstado(e);
    refrescarPanel(`${mensaje} Procesados: ${e.total || 0}.`);
  }

  let corriendo = false;
  async function ejecutar() {
    if (corriendo) return;
    corriendo = true;
    let intentosSinTabla = 0;

    try {
      while (leerEstado().activo) {
        const tabla = encontrarTabla();
        if (!tabla) {
          if (++intentosSinTabla > 10) { detener('No se encontró la tabla de expedientes.'); break; }
          await sleep(500);
          continue;
        }
        intentosSinTabla = 0;

        const e = leerEstado();
        const fila = siguienteFila(tabla, e.procesados || []);
        if (!fila) { detener('Listo, no quedan casillas pendientes.'); break; }

        fila.tr.scrollIntoView({ block: 'center' });
        escribir(fila.input, e.caja);
        await sleep(150);
        fila.boton.click();
        fila.tr.dataset.botHecho = '1';

        e.total = (e.total || 0) + 1;
        if (fila.id) e.procesados = [...(e.procesados || []), fila.id];
        guardarEstado(e);
        refrescarPanel(`Caja ${e.caja} → ID ${fila.id || '?'} (${e.total} hechos)`);

        await sleep(ESPERA_MS);
      }
    } catch (err) {
      console.error('[Bot Caja]', err);
      detener('Error: ' + err.message);
    } finally {
      corriendo = false;
    }
  }

  // ---------- Arranque ----------
  function arrancar() {
    if (!esPaginaCorrecta() || document.getElementById('bot-caja-panel')) return;
    crearPanel();
    const e = leerEstado();
    if (e.activo) {               // si la página se recargó a mitad del proceso, continúa
      refrescarPanel('Reanudando…');
      setTimeout(ejecutar, 800);
    } else {
      refrescarPanel('');
    }
  }

  arrancar();
  // por si la pantalla carga el contenido después
  const obs = new MutationObserver(() => arrancar());
  obs.observe(document.documentElement, { childList: true, subtree: true });
})();
